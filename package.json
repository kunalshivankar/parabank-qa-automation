{
  "name": "parabank-qa-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright + TypeScript automation framework for ParaBank",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:reporter": "playwright test --project=reporter-ui",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "report:open": "node scripts/openReport.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
