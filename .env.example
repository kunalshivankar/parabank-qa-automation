# Copy to .env for local overrides. Never commit .env.

# Base URL of the ParaBank instance under test
PARABANK_BASE_URL=https://parabank.parasoft.com

# Global database reset (cleanDB / initializeDB) wipes data for EVERYONE on a shared sandbox.
# Keep this false unless you own the target environment.
PARABANK_ALLOW_GLOBAL_RESET=false

# Loan execution requires the provider to already be configured and explicit authorization.
# Keep false unless the target environment and loan test execution are authorized.
PARABANK_ALLOW_LOAN_WORKFLOW=false

# Parallel workers. Kept low by default to be polite to the shared public sandbox.
WORKERS=2

# Optional: fixed run identifier (default: generated once per run)
# RUN_ID=

# Registration mode for Phase 2A: automatic (default) or manual
REGISTRATION_MODE=automatic

# Required only when REGISTRATION_MODE=manual. Use a unique username.
# MANUAL_FIRST_NAME=
# MANUAL_LAST_NAME=
# MANUAL_ADDRESS=
# MANUAL_CITY=
# MANUAL_STATE=
# MANUAL_ZIP_CODE=
# MANUAL_PHONE_NUMBER=
# MANUAL_SSN=
# MANUAL_USERNAME=
# MANUAL_PASSWORD=

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Optional: use an already-installed Chromium/Chrome instead of Playwright's downloaded browser
# CHROMIUM_EXECUTABLE_PATH=

# Raw Playwright videos and traces can contain form values and network payloads.
# Keep disabled by default; use only in a private authorized environment and never share the artifacts.
PARABANK_RETAIN_RAW_ARTIFACTS=false

# Optional report metadata; unset values are shown as "Not provided"
# TESTER_NAME=
# TESTER_DESIGNATION=
# PROJECT_NAME=ParaBank QA Automation
# TEST_ENVIRONMENT=
# BROWSER_NAME=
# BROWSER_VERSION=
# HEADED=false
# BUILD_NUMBER=
