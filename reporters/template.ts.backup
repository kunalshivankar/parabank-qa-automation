import {
  formatDuration,
  formatPercent,
  type ProjectSummary,
  type ReportAttachment,
  type ReportData,
  type ReportError,
  type ReportTest,
  type RunStatus,
  type TestStatus,
} from './model';

export const ACCENT_COLOR = '#F48031';

const STATUS_LABEL: Record<TestStatus, string> = {
  passed: 'Passed',
  failed: 'Failed',
  flaky: 'Flaky',
  skipped: 'Skipped',
};

const RUN_STATUS_LABEL: Record<RunStatus, string> = {
  passed: 'Run passed',
  failed: 'Run failed',
  timedout: 'Run timed out',
  interrupted: 'Run interrupted',
};

export function escapeHtml(value: string): string {
  return value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

const STYLES = `
:root {
  color-scheme: dark;
  --accent: ${ACCENT_COLOR};
  --ink: #0f1330;
  --text: #eef1ff;
  --muted: #a9b0d6;
  --fail: #ff6b81;
  --flaky: #6cc4ff;
  --skip: #9aa3c7;
  --glass-fill: rgba(255, 255, 255, 0.08);
  --glass-edge: rgba(255, 255, 255, 0.22);
  --blur: 18px;
  --radius: 18px;
  --font: "Avenir Next", "Segoe UI Variable Text", "Segoe UI", system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
  --mono: ui-monospace, "SF Mono", "Cascadia Mono", Consolas, "Liberation Mono", monospace;
}
* { box-sizing: border-box; }
html { background: var(--ink); }
body {
  margin: 0;
  min-height: 100vh;
  font: 15px/1.55 var(--font);
  color: var(--text);
  background:
    radial-gradient(1200px 700px at 12% -10%, #2a2f7a 0%, transparent 60%),
    radial-gradient(900px 600px at 100% 10%, #123f5c 0%, transparent 55%),
    linear-gradient(160deg, #0f1330 0%, #0b0f26 100%);
  background-attachment: fixed;
}
.backdrop { position: fixed; inset: 0; overflow: hidden; z-index: 0; pointer-events: none; }
.orb { position: absolute; border-radius: 50%; filter: blur(70px); opacity: 0.6; }
.orb-violet { width: 520px; height: 520px; left: -120px; top: 120px; background: #5b3df5; }
.orb-teal { width: 460px; height: 460px; right: -80px; top: 260px; background: #0fb5a8; }
.orb-rose { width: 400px; height: 400px; left: 38%; bottom: -160px; background: #d92d7a; }
.app { position: relative; z-index: 1; max-width: 1120px; margin: 0 auto; padding: 40px 24px 64px; }

h1, h2, h3 { color: var(--accent); margin: 0; font-weight: 700; letter-spacing: -0.015em; }
h1 { font-size: clamp(1.9rem, 3.2vw, 2.6rem); line-height: 1.1; }
h2 { font-size: 1.25rem; }
h3 { font-size: 0.95rem; font-weight: 650; letter-spacing: 0; }
h4 { margin: 0 0 6px; font-size: 0.8rem; font-weight: 600; color: var(--muted); }
p { margin: 0; }

.glass {
  background-color: var(--glass-fill);
  background-image: linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0) 60%);
  -webkit-backdrop-filter: blur(var(--blur)) saturate(150%);
  backdrop-filter: blur(var(--blur)) saturate(150%);
  border: 1px solid var(--glass-edge);
  border-radius: var(--radius);
  box-shadow: 0 12px 32px rgba(4, 6, 24, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.28);
}
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .glass { background-color: rgba(26, 32, 84, 0.92); }
}
.glass-inset {
  background-color: rgba(255, 255, 255, 0.06);
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 12px;
}

:focus-visible { outline: 2px solid #ffffff; outline-offset: 2px; }
.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

.masthead { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 28px; }
.subtitle { margin-top: 8px; color: var(--muted); max-width: 60ch; }
.run-state { display: inline-flex; align-items: center; gap: 10px; padding: 10px 18px; font-weight: 600; }

.status { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; }
.dot { display: inline-block; width: 0.7rem; height: 0.7rem; border-radius: 50%; background: var(--skip); box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.08); flex: none; }
.dot[data-status="passed"] { background-color: var(--accent); }
.dot[data-status="failed"] { background-color: var(--fail); }
.dot[data-status="flaky"] { background-color: var(--flaky); }
.dot[data-status="skipped"] { background-color: var(--skip); }
.status[data-status="passed"] { color: var(--accent); }
.status[data-status="failed"] { color: var(--fail); }
.status[data-status="flaky"] { color: var(--flaky); }
.status[data-status="skipped"] { color: var(--skip); }

.tabs { display: inline-flex; gap: 6px; padding: 6px; margin-bottom: 24px; border-radius: 999px; }
.tab {
  appearance: none; border: 0; cursor: pointer; font: inherit; font-weight: 600;
  padding: 9px 20px; border-radius: 999px; background: transparent; color: var(--muted);
  display: inline-flex; align-items: center; gap: 8px; transition: background-color 0.15s, color 0.15s;
}
.tab:hover { color: var(--text); }
.tab[aria-selected="true"] { background-color: var(--accent); color: #1b1006; }
.tab .count { font-size: 0.78rem; padding: 1px 8px; border-radius: 999px; background: rgba(255, 255, 255, 0.14); }
.tab[aria-selected="true"] .count { background: rgba(27, 16, 6, 0.18); }

.summary-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
.card { padding: 20px 22px; }
.card h3 { margin-bottom: 10px; }
.hero { grid-column: span 2; grid-row: span 2; display: flex; flex-direction: column; justify-content: center; }
.hero-value { font-size: 3.4rem; line-height: 1; font-weight: 750; letter-spacing: -0.03em; }
.hero-note { margin-top: 8px; color: var(--muted); }
.bar { display: flex; gap: 3px; height: 12px; margin-top: 18px; padding: 2px; border-radius: 999px; background: rgba(255, 255, 255, 0.08); }
.seg { flex: 1 1 0; border-radius: 999px; min-width: 6px; }
.seg[data-status="passed"] { background-color: var(--accent); }
.seg[data-status="failed"] { background-color: var(--fail); }
.seg[data-status="flaky"] { background-color: var(--flaky); }
.seg[data-status="skipped"] { background-color: var(--skip); }
.stat-value { font-size: 2.1rem; font-weight: 700; line-height: 1.1; letter-spacing: -0.02em; }
.stat-value[data-status="passed"] { color: var(--accent); }
.stat-value[data-status="failed"][data-nonzero="true"] { color: var(--fail); }
.stat-value[data-status="flaky"][data-nonzero="true"] { color: var(--flaky); }
.stat-value[data-zero="true"] { color: var(--muted); }
.wide { grid-column: span 2; }
.full { grid-column: 1 / -1; }

table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
th { text-align: left; font-weight: 600; color: var(--muted); padding: 6px 8px 6px 0; }
td { padding: 6px 8px 6px 0; border-top: 1px solid rgba(255, 255, 255, 0.1); }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
dl.facts { display: grid; grid-template-columns: max-content 1fr; gap: 6px 18px; margin: 0; font-size: 0.92rem; }
dl.facts.cols { grid-template-columns: max-content 1fr max-content 1fr; gap: 8px 28px; }
dl.facts dt { color: var(--muted); }
dl.facts dd { margin: 0; word-break: break-word; }

.toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; padding: 12px 14px; margin-bottom: 16px; }
.chips { display: flex; flex-wrap: wrap; gap: 8px; }
.chip {
  appearance: none; cursor: pointer; font: inherit; font-size: 0.88rem; font-weight: 600; color: var(--text);
  padding: 6px 14px; border-radius: 999px; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.16);
}
.chip[aria-pressed="true"] { background: rgba(255, 255, 255, 0.22); border-color: rgba(255, 255, 255, 0.55); }
.chip span { color: var(--muted); margin-left: 6px; font-weight: 500; }
.search input {
  font: inherit; color: var(--text); width: min(320px, 100%); padding: 8px 14px; border-radius: 999px;
  background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.2);
}
.search input::placeholder { color: var(--muted); }

.test-list { display: grid; gap: 10px; }
.test > summary { list-style: none; cursor: pointer; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 16px; padding: 14px 18px; }
.test > summary::-webkit-details-marker { display: none; }
.test .status { min-width: 5.5rem; }
.test-title { flex: 1 1 280px; font-weight: 600; }
.test-where, .test-project, .test-time { color: var(--muted); font-size: 0.86rem; }
.test-time { font-variant-numeric: tabular-nums; min-width: 4.5rem; text-align: right; }
.test-body { display: grid; gap: 14px; padding: 4px 18px 18px; }
.evidence { display: grid; gap: 8px; padding: 12px 14px; }
pre {
  margin: 0; padding: 12px 14px; overflow-x: auto; white-space: pre-wrap; word-break: break-word;
  font: 0.82rem/1.5 var(--mono); border-radius: 10px; background: rgba(6, 8, 28, 0.55); border: 1px solid rgba(255, 255, 255, 0.1);
}
pre.error { border-left: 3px solid var(--fail); }
figure { margin: 0; }
figure img { display: block; max-width: 100%; max-height: 360px; width: auto; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.18); }
.attachment > summary { cursor: pointer; padding: 10px 14px; font-size: 0.88rem; color: var(--muted); }
.attachment > pre { margin: 0 14px 14px; max-height: 360px; overflow: auto; }
figcaption { margin-top: 6px; font-size: 0.82rem; color: var(--muted); }
a { color: var(--text); text-underline-offset: 3px; }
.empty { padding: 28px; text-align: center; color: var(--muted); }

@media (min-width: 821px) {
  .test > summary { display: grid; grid-template-columns: 6rem minmax(0, 1fr) minmax(0, 17rem) 4rem 4.5rem; gap: 6px 16px; }
  .test .status { min-width: 0; }
  .test-where { overflow-wrap: anywhere; }
}
@media (max-width: 820px) {
  .summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .hero { grid-row: auto; }
  dl.facts.cols { grid-template-columns: max-content 1fr; }
}
@media (max-width: 480px) {
  .app { padding: 24px 14px 48px; }
  .summary-grid { grid-template-columns: minmax(0, 1fr); }
  .hero, .wide { grid-column: span 1; }
  .tabs { display: flex; }
  .tab { flex: 1; justify-content: center; padding: 9px 10px; }
}
@media (prefers-reduced-motion: reduce) {
  * { transition: none !important; }
}
`;

const SCRIPT = `
(function () {
  var tabs = Array.prototype.slice.call(document.querySelectorAll('[role="tab"]'));
  var panels = Array.prototype.slice.call(document.querySelectorAll('[role="tabpanel"]'));

  function activate(id, moveFocus) {
    tabs.forEach(function (tab) {
      var selected = tab.getAttribute('data-tab') === id;
      tab.setAttribute('aria-selected', selected ? 'true' : 'false');
      tab.tabIndex = selected ? 0 : -1;
      if (selected && moveFocus) tab.focus();
    });
    panels.forEach(function (panel) {
      panel.hidden = panel.getAttribute('data-panel') !== id;
    });
    if (window.history && window.history.replaceState) {
      window.history.replaceState(null, '', '#' + id);
    }
  }

  tabs.forEach(function (tab, index) {
    tab.addEventListener('click', function () { activate(tab.getAttribute('data-tab'), false); });
    tab.addEventListener('keydown', function (event) {
      var next = null;
      if (event.key === 'ArrowRight') next = tabs[(index + 1) % tabs.length];
      if (event.key === 'ArrowLeft') next = tabs[(index - 1 + tabs.length) % tabs.length];
      if (event.key === 'Home') next = tabs[0];
      if (event.key === 'End') next = tabs[tabs.length - 1];
      if (next) { event.preventDefault(); activate(next.getAttribute('data-tab'), true); }
    });
  });

  var known = tabs.map(function (tab) { return tab.getAttribute('data-tab'); });
  var initial = window.location.hash.replace('#', '');
  activate(known.indexOf(initial) >= 0 ? initial : 'summary', false);

  var chips = Array.prototype.slice.call(document.querySelectorAll('.chip'));
  var rows = Array.prototype.slice.call(document.querySelectorAll('#panel-tests .test'));
  var search = document.getElementById('test-search');
  var emptyNote = document.getElementById('tests-empty');
  var statusFilter = 'all';

  function applyFilters() {
    var term = search ? search.value.trim().toLowerCase() : '';
    var visible = 0;
    rows.forEach(function (row) {
      var statusMatch = statusFilter === 'all' || row.getAttribute('data-status') === statusFilter;
      var textMatch = term === '' || (row.getAttribute('data-search') || '').indexOf(term) >= 0;
      row.hidden = !(statusMatch && textMatch);
      if (!row.hidden) visible += 1;
    });
    if (emptyNote) emptyNote.hidden = visible !== 0;
  }

  chips.forEach(function (chip) {
    chip.addEventListener('click', function () {
      statusFilter = chip.getAttribute('data-filter');
      chips.forEach(function (other) { other.setAttribute('aria-pressed', other === chip ? 'true' : 'false'); });
      applyFilters();
    });
  });
  if (search) search.addEventListener('input', applyFilters);
})();
`;

function renderStatus(status: TestStatus, label: string = STATUS_LABEL[status]): string {
  return `<span class="status" data-status="${status}"><span class="dot" data-status="${status}"></span>${escapeHtml(label)}</span>`;
}

function renderAttachment(attachment: ReportAttachment): string {
  const caption = `${escapeHtml(attachment.name)} (attempt ${attachment.attempt})`;
  switch (attachment.kind) {
    case 'image':
      return `<figure data-attachment="image"><img src="${attachment.dataUri ?? ''}" alt="${escapeHtml(attachment.name)}" loading="lazy"><figcaption>${caption}</figcaption></figure>`;
    case 'text':
      return `<details class="attachment glass-inset" data-attachment="text"><summary>${caption}</summary><pre>${escapeHtml(attachment.text ?? '')}</pre></details>`;
    case 'file':
      return `<p data-attachment="file"><a href="${escapeHtml(attachment.href ?? '#')}">${caption}</a></p>`;
    case 'unavailable':
      return `<p data-attachment="unavailable">${caption}: ${escapeHtml(attachment.note ?? 'not available')}</p>`;
  }
}

function renderError(error: ReportError): string {
  const location = error.location ? `<p class="test-where">${escapeHtml(error.location)}</p>` : '';
  const snippet = error.snippet ? `<pre>${escapeHtml(error.snippet)}</pre>` : '';
  return `<section class="evidence glass-inset" data-evidence="error"><h4>Error on attempt ${error.attempt}</h4><pre class="error">${escapeHtml(error.message)}</pre>${location}${snippet}</section>`;
}

function renderTest(test: ReportTest, options: { open: boolean; searchable: boolean }): string {
  const searchText = escapeHtml(`${test.title} ${test.file} ${test.project}`.toLowerCase());
  const attemptsLabel = test.attempts === 1 ? '1 attempt' : `${test.attempts} attempts`;
  const notes = test.annotations
    .map((annotation) => `${annotation.type}${annotation.description ? `: ${annotation.description}` : ''}`)
    .join('; ');

  const facts = [
    `<dt>Result</dt><dd>${escapeHtml(test.outcomeDetail)}, ${attemptsLabel}</dd>`,
    `<dt>File</dt><dd>${escapeHtml(test.file)}:${test.line}</dd>`,
    test.tags.length > 0 ? `<dt>Tags</dt><dd>${escapeHtml(test.tags.join(' '))}</dd>` : '',
    notes ? `<dt>Annotations</dt><dd>${escapeHtml(notes)}</dd>` : '',
  ].join('');

  return `
<details class="test glass" data-status="${test.status}"${options.searchable ? ` data-search="${searchText}"` : ''}${options.open ? ' open' : ''}>
  <summary>
    ${renderStatus(test.status)}
    <span class="test-title">${escapeHtml(test.title)}</span>
    <span class="test-where">${escapeHtml(test.file)}:${test.line}</span>
    <span class="test-project">${escapeHtml(test.project)}</span>
    <span class="test-time">${formatDuration(test.durationMs)}</span>
  </summary>
  <div class="test-body">
    ${test.errors.map(renderError).join('')}
    ${test.attachments.map(renderAttachment).join('')}
    <dl class="facts glass-inset" style="padding: 12px 14px">${facts}</dl>
  </div>
</details>`;
}

function renderStat(label: string, value: string, status: TestStatus | undefined, rawCount?: number): string {
  const statusAttr = status ? ` data-status="${status}"` : '';
  const countAttr = rawCount === undefined ? '' : rawCount > 0 ? ' data-nonzero="true"' : ' data-zero="true"';
  return `<article class="card glass" data-card="${escapeHtml(label.toLowerCase())}"><h3>${escapeHtml(label)}</h3><p class="stat-value"${statusAttr}${countAttr}>${escapeHtml(value)}</p></article>`;
}

function renderProjectRow(project: ProjectSummary): string {
  return `<tr><td>${escapeHtml(project.name)}</td><td class="num">${project.total}</td><td class="num">${project.passed}</td><td class="num">${project.failed}</td><td class="num">${project.flaky}</td><td class="num">${project.skipped}</td></tr>`;
}

function renderSummary(data: ReportData): string {
  const { totals } = data;
  const executed = totals.passed + totals.failed + totals.flaky;
  const segments = (['passed', 'failed', 'flaky', 'skipped'] as const)
    .filter((status) => totals[status] > 0)
    .map(
      (status) =>
        `<span class="seg" data-status="${status}" style="flex-grow: ${totals[status]}" title="${STATUS_LABEL[status]}: ${totals[status]}"></span>`,
    )
    .join('');
  const heroNote =
    executed === 0
      ? 'No tests were executed in this run.'
      : `${totals.passed} of ${executed} executed ${executed === 1 ? 'test' : 'tests'} passed on the first attempt.`;

  const environment = data.environment
    .map((entry) => `<dt>${escapeHtml(entry.label)}</dt><dd>${escapeHtml(entry.value)}</dd>`)
    .join('');

  return `
<div class="summary-grid">
  <article class="card glass hero" data-card="pass rate">
    <h3>Pass rate</h3>
    <p class="hero-value">${escapeHtml(formatPercent(totals.passRate))}</p>
    <p class="hero-note">${escapeHtml(heroNote)}</p>
    <div class="bar" role="img" aria-label="Outcome distribution">${segments}</div>
  </article>
  ${renderStat('Passed', String(totals.passed), 'passed', totals.passed)}
  ${renderStat('Failed', String(totals.failed), 'failed', totals.failed)}
  ${renderStat('Flaky', String(totals.flaky), 'flaky', totals.flaky)}
  ${renderStat('Skipped', String(totals.skipped), 'skipped', totals.skipped)}
  ${renderStat('Total tests', String(totals.total), undefined)}
  ${renderStat('Duration', formatDuration(data.durationMs), undefined)}
  <article class="card glass wide" data-card="projects">
    <h3>By project</h3>
    <table>
      <thead><tr><th>Project</th><th class="num">Total</th><th class="num">Passed</th><th class="num">Failed</th><th class="num">Flaky</th><th class="num">Skipped</th></tr></thead>
      <tbody>${data.projects.map(renderProjectRow).join('')}</tbody>
    </table>
  </article>
  <article class="card glass full" data-card="environment">
    <h3>Environment</h3>
    <dl class="facts cols">${environment}</dl>
  </article>
</div>`;
}

function renderTestsPanel(data: ReportData): string {
  const { totals } = data;
  const chip = (filter: string, label: string, count: number, pressed: boolean): string =>
    `<button type="button" class="chip" data-filter="${filter}" aria-pressed="${pressed}">${label}<span>${count}</span></button>`;

  return `
<div class="toolbar glass">
  <div class="chips" role="group" aria-label="Filter by status">
    ${chip('all', 'All', totals.total, true)}
    ${chip('passed', 'Passed', totals.passed, false)}
    ${chip('failed', 'Failed', totals.failed, false)}
    ${chip('flaky', 'Flaky', totals.flaky, false)}
    ${chip('skipped', 'Skipped', totals.skipped, false)}
  </div>
  <label class="search">
    <span class="visually-hidden">Search tests</span>
    <input id="test-search" type="search" placeholder="Search by title, file or project" autocomplete="off">
  </label>
</div>
<div class="test-list">${data.tests.map((test) => renderTest(test, { open: false, searchable: true })).join('')}</div>
<p id="tests-empty" class="empty glass" ${data.tests.length === 0 ? '' : 'hidden'}>No tests match the current filter.</p>`;
}

function renderSummaryPanel(failing: readonly ReportTest[]): string {
  if (failing.length === 0) {
    return '<p class="empty glass" data-empty="Summary">No failed or flaky tests in this run.</p>';
  }
  return `<div class="test-list">${failing.map((test) => renderTest(test, { open: true, searchable: false })).join('')}</div>`;
}

export function renderReport(data: ReportData): string {
  const failing = data.tests.filter((test) => test.status === 'failed' || test.status === 'flaky');
  const runStatusClass: TestStatus = data.runStatus === 'passed' ? 'passed' : 'failed';
  const startedAt = new Date(data.startedAt);
  const startedLabel = Number.isNaN(startedAt.getTime())
    ? data.startedAt
    : startedAt.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'medium' });

  return `<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${escapeHtml(data.title)}</title>
<style>${STYLES}</style>
</head>
<body>
<div class="backdrop" aria-hidden="true">
  <div class="orb orb-violet"></div>
  <div class="orb orb-teal"></div>
  <div class="orb orb-rose"></div>
</div>
<div class="app">
  <header class="masthead">
    <div>
      <h1>${escapeHtml(data.title)}</h1>
      <p class="subtitle">Started ${escapeHtml(startedLabel)} and finished in ${formatDuration(data.durationMs)}.</p>
    </div>
    <div class="run-state glass" data-run-status="${data.runStatus}">${renderStatus(runStatusClass, RUN_STATUS_LABEL[data.runStatus])}</div>
  </header>

  <nav class="tabs glass" role="tablist" aria-label="Report sections">
    <button type="button" class="tab" role="tab" id="tab-summary" data-tab="summary" aria-controls="panel-summary" aria-selected="true">Summary</button>
    <button type="button" class="tab" role="tab" id="tab-tests" data-tab="tests" aria-controls="panel-tests" aria-selected="false" tabindex="-1">Tests <span class="count">${data.totals.total}</span></button>
    <button type="button" class="tab" role="tab" id="tab-Summary" data-tab="Summary" aria-controls="panel-Summary" aria-selected="false" tabindex="-1">Summary <span class="count">${failing.length}</span></button>
  </nav>

  <main>
    <section role="tabpanel" id="panel-summary" data-panel="summary" aria-labelledby="tab-summary">
      <h2 class="visually-hidden">Summary</h2>
      ${renderSummary(data)}
    </section>
    <section role="tabpanel" id="panel-tests" data-panel="tests" aria-labelledby="tab-tests" hidden>
      <h2 class="visually-hidden">Tests</h2>
      ${renderTestsPanel(data)}
    </section>
    <section role="tabpanel" id="panel-Summary" data-panel="Summary" aria-labelledby="tab-Summary" hidden>
      <h2 class="visually-hidden">Summary</h2>
      ${renderSummaryPanel(failing)}
    </section>
  </main>
</div>
<script>${SCRIPT}</script>
</body>
</html>
`;
}
